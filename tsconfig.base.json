{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@ar4-sim/source"],
    "rootDir": ".",
    "paths": {
      ":ar4-sim/sim-for-ar4": ["./packages/sim-for-ar4/src/index.ts"],
      ":ar4-sim/common-constructs": [
        "./packages/common/constructs/src/index.ts"
      ],
      ":ar4-sim/infra": ["./packages/infra/src/index.ts"]
    }
  }
}
