<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dummy Robot V2 URDF
  基于稚晖君 Dummy V2 固件 DH 参数生成

  DH 参数 (标准 DH 约定):
    Link 1: θ_off=0,    d=126.5, a=35,   α=-90°
    Link 2: θ_off=-90°, d=0,     a=146,  α=0°
    Link 3: θ_off=+90°, d=52,    a=0,    α=+90°
    Link 4: θ_off=0,    d=117,   a=0,    α=-90°
    Link 5: θ_off=0,    d=0,     a=0,    α=+90°
    Link 6: θ_off=0,    d=75.5,  a=0,    α=0°

  单位: 米 (m), 弧度 (rad)
  连杆参数: L_BS=126.5mm, D_BS=35mm, L_AM=146mm, L_FA=117mm, D_EW=52mm, L_WT=75.5mm
-->
<robot name="dummy_v2">

  <!-- ==================== Materials ==================== -->
  <material name="dark_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="dummy_red">
    <color rgba="0.8 0.13 0.13 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="1.0 0.7 0.0 1.0"/>
  </material>

  <!-- ==================== Base ==================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://dummy-sim/meshes/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ==================== Link 1: 底座旋转 ==================== -->
  <!-- DH: θ_off=0, d=0.1265, a=0.035, α=-π/2 -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0.035 0 0.1265" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="10" velocity="2.0"/>
  </joint>

  <link name="link_1">
    <visual>
      <geometry>
        <mesh filename="package://dummy-sim/meshes/j1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dummy_red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <!-- ==================== Link 2: 大臂 ==================== -->
  <!-- DH: θ_off=-π/2, d=0, a=0.146, α=0 -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.146 0 0" rpy="0 0 ${-pi/2}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-170*pi/180}" upper="${170*pi/180}" effort="10" velocity="2.0"/>
  </joint>

  <link name="link_2">
    <visual>
      <geometry>
        <mesh filename="package://dummy-sim/meshes/j2j3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.146 0.04 0.04"/>
      </geometry>
      <origin xyz="0.073 0 0"/>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ==================== Link 3: 肘部 ==================== -->
  <!-- DH: θ_off=+π/2, d=0.052, a=0, α=+π/2 -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.052" rpy="${pi/2} 0 ${pi/2}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-75*pi/180}" upper="${90*pi/180}" effort="10" velocity="2.0"/>
  </joint>

  <link name="link_3">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.117"/>
      </geometry>
      <origin xyz="0 0 0.0585"/>
      <material name="dummy_red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.117"/>
      </geometry>
      <origin xyz="0 0 0.0585"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ==================== Link 4: 前臂 ==================== -->
  <!-- DH: θ_off=0, d=0.117, a=0, α=-π/2 -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.117" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="${pi}" effort="5" velocity="3.0"/>
  </joint>

  <link name="link_4">
    <visual>
      <geometry>
        <mesh filename="package://dummy-sim/meshes/j4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.015" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ==================== Link 5: 腕部偏转 ==================== -->
  <!-- DH: θ_off=0, d=0, a=0, α=+π/2 -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="5" velocity="3.0"/>
  </joint>

  <link name="link_5">
    <visual>
      <geometry>
        <mesh filename="package://dummy-sim/meshes/j5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dummy_red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.015" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <!-- ==================== Link 6: 腕部旋转/末端 ==================== -->
  <!-- DH: θ_off=0, d=0.0755, a=0, α=0 -->
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0 0 0.0755" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-100*pi/180}" upper="${120*pi/180}" effort="3" velocity="4.0"/>
  </joint>

  <link name="link_6">
    <visual>
      <geometry>
        <mesh filename="package://dummy-sim/meshes/j6.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.015" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ==================== 末端工具坐标系 ==================== -->
  <joint name="tool_joint" type="fixed">
    <parent link="link_6"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool_link"/>

</robot>
